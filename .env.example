# Server-only AI settings. Never prefix these with NEXT_PUBLIC_.
AI_PROVIDER=ollama
AI_BASE_URL=http://127.0.0.1:11434
AI_MODEL=llama3.2:latest
# AI_API_KEY is required only for authenticated remote providers such as Ollama Cloud.

# Hosted Fireworks AI example (recommended for Vercel):
# AI_PROVIDER=fireworks
# AI_BASE_URL=https://api.fireworks.ai/inference/v1
# AI_MODEL=accounts/fireworks/models/glm-5p2
# FIREWORKS_API_KEY=replace-with-a-server-only-fireworks-api-key

# Vercel / Ollama Cloud example (set these in Vercel, not in client code):
# AI_PROVIDER=ollama
# AI_BASE_URL=https://ollama.com
# AI_MODEL=gpt-oss:120b
# AI_API_KEY=replace-with-a-server-only-ollama-api-key

# Clerk development keys. Copy these from the Clerk dashboard and never commit values.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Local development uses an in-memory rate limiter automatically. For Vercel,
# configure an Upstash Redis database so limits are shared across server instances.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Some Vercel Marketplace integrations use equivalent names instead:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Use a long random value. It hashes client identifiers before rate-limit storage.
# RATE_LIMIT_ID_SALT= (optional when CLERK_SECRET_KEY is configured)
